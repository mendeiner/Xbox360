VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Used by one-off data pipeline scripts (rawg_enrich.mjs, compress_covers_nsw.py, etc).
RAWG_API_KEY=your_rawg_api_key_here

# Direct Postgres connection (DB password, not the anon key above) — used only by
# apply_schema.mjs to apply supabase/schema.sql without pasting SQL into the dashboard by hand.
# From Supabase dashboard: project -> Connect -> Direct connection -> URI.
SUPABASE_DB_URL=postgresql://postgres:your_db_password@db.your-project-id.supabase.co:5432/postgres
